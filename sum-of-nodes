#include <iostream>
#include <vector>

using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n;
    if (!(cin >> n)) return 0;

    vector<int> nodes(n);
    for (int i = 0; i < n; ++i) {
        cin >> nodes[i];
    }

    int start, end;
    cin >> start >> end;

    long long sum = 0;
    
    for (int i = 0; i < n; ++i) {
        if (nodes[i] >= start && nodes[i] <= end) {
            sum += nodes[i];
        }
    }

    cout << sum << "\n";

    return 0;
}
