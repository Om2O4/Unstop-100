#include <iostream>
using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n;
    if (cin >> n) {
        long long val = 1;
        for (int k = 0; k <= n; ++k) {
            cout << val << (k == n ? "" : " ");
            val = val * (n - k) / (k + 1);
        }
        cout << "\n";
    }

    return 0;
}
